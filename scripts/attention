#!/usr/bin/env python3
"""Publish owner decisions or acknowledge voice returns with a scoped local key."""
import argparse
import json
import os
from pathlib import Path
import time
import urllib.request

p=argparse.ArgumentParser()
p.add_argument('action',nargs='?',choices=['submit','acknowledge'],default='submit')
p.add_argument('--source',choices=['hermes','t3'],required=True)
p.add_argument('--dedupe');p.add_argument('--title');p.add_argument('--body')
p.add_argument('--priority',choices=['routine','important','urgent'],default='routine')
p.add_argument('--decision',action='store_true');p.add_argument('--minutes',type=int,default=60)
p.add_argument('--thread-id',help='Originating local T3 thread; defaults to T3CODE_THREAD_ID.')
p.add_argument('--decision-id');p.add_argument('--status',choices=['accepted','needs_clarification','declined'])
p.add_argument('--note',default='')
a=p.parse_args()
c=json.loads((Path.home()/'.config/hermes-voice'/('producer-'+a.source+'.json')).read_text())
url=c['url']
if a.action=='acknowledge':
    if not a.decision_id or not a.status:p.error('acknowledge requires --decision-id and --status')
    import uuid
    try:uuid.UUID(a.decision_id)
    except ValueError:p.error('--decision-id must be a UUID')
    url=url.rsplit('/v1/events',1)[0]+'/v1/decisions/'+a.decision_id+'/ack'
    data={'status':a.status,'note':a.note}
else:
    if not all([a.dedupe,a.title,a.body]):p.error('submit requires --dedupe, --title and --body')
    data={'dedupe':a.dedupe,'title':a.title,'body':a.body,'priority':a.priority,'decision':a.decision,'deadline':time.time()+max(1,min(10080,a.minutes))*60}
    thread=a.thread_id or os.environ.get('T3CODE_THREAD_ID')
    if a.source=='t3' and a.decision:
        if not thread:p.error('T3 decision events require --thread-id or T3CODE_THREAD_ID so the answer can return')
        data['origin']={'kind':'t3','thread_id':thread}
r=urllib.request.Request(url,data=json.dumps(data).encode(),headers={'Authorization':'Bearer '+c['token'],'Content-Type':'application/json'})
try:
    with urllib.request.urlopen(r,timeout=25) as response:print(response.read().decode())
except urllib.error.HTTPError as error:
    raise SystemExit('Attention request was rejected (HTTP '+str(error.code)+'). Nothing was confirmed; reuse the same issue ID when checking.')
